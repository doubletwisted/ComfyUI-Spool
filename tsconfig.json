    "ui/dialogs.js",
    "ui/action-menu.js",
    "ui/viewer.js",
    "ui/timeline-renderer.js",
    "ui/timeline-pointer.js",
    "ui/inspector-renderer.js",
    "ui/library-renderer.js",
    "ui/workflow-coordinator.js"
